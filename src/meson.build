grid_deps = [
  dependency('gtk4', version: '>= 4.12'),
  dependency('libadwaita-1', version: '>= 1.4'),
  dependency('gtk4-layer-shell-0', version: '>= 1.0'),
  dependency('json-glib-1.0'),
  dependency('gio-unix-2.0'),
  dependency('manette-0.2'),
]

grid_sources = files(
  'config.vapi',
  'main.vala',
  'application.vala',
  'config.vala',
  'describe.vala',
  'app-info.vala',
  'app-provider.vala',
  'grid-window.vala',
  'tile.vala',
  'tile-placement.vala',
  'tile-model.vala',
  'folder-animator.vala',
  'tile-board.vala',
  'tile-grid.vala',
  'folder-tile.vala',
  'search-bar.vala',
  'search-provider.vala',
  'layer-shell-helper.vala',
  'compositor-helper.vala',
  'hyprland-helper.vala',
  'niri-helper.vala',
  'dock-dbus-client.vala',
  'dbus-service.vala',
  'gamepad-controller.vala',
)

executable('ximper-shell-launcher', grid_sources,
  dependencies: grid_deps,
  include_directories: include_directories('..'),
  c_args: ['-DGETTEXT_PACKAGE="ximper-shell-launcher"', '-w'],
  install: true,
)
